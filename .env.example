# Copy this file to .env and fill in your real values.
# .env is gitignored. This file is safe to commit.

ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# --- third-party provider keys (only needed when a model id routes there) ---
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...            # Grok (xAI). Required for any grok-* model id.

# --- model overrides ---
# Faculties route by id:  claude-* -> Anthropic | gpt-*/o-series -> OpenAI |
#                         gemini-* -> Google     | grok-* -> xAI
# Switching a faculty is a single line here — no code change.
#
#   EAU_MODEL  = the arbiter / "cook" that writes the reply
#   IGL_MODEL  = the fast affective read
#
# EAU_MODEL=claude-sonnet-4-6
# IGL_MODEL=claude-haiku-4-5-20251001
#
# OpenAI examples (need OPENAI_API_KEY):
# IGL_MODEL=gpt-5-mini
# EAU_MODEL=gpt-5.4
# NOTE: free shared-traffic tier covers gpt-5.x up to 5.4 + mini/nano — NOT gpt-5.5.
# Optional gateway endpoint (leave unset for api.openai.com):
# OPENAI_BASE_URL=https://...
#
# Grok cook example (needs XAI_API_KEY):
#   EAU_MODEL=grok-4.3            # confirm the exact id in your xAI console
#   IGL_MODEL=claude-haiku-4-5-20251001   # hold IGL constant across cooks
# xAI endpoint (OpenAI-SDK-compatible; default shown, override only for a gateway):
# XAI_BASE_URL=https://api.x.ai/v1

# --- judge model overrides ---
# JUDGE_CLAUDE_MODEL=claude-haiku-4-5-20251001
# JUDGE_GEMINI_MODEL=gemini-2.5-flash
# JUDGE_OPENAI_MODEL=gpt-4o-mini
# JUDGE_XAI_MODEL=grok-4.3       # Grok as a judge (needs XAI_API_KEY)
# JUDGE_XAI_MAX_TOKENS=4096      # headroom so a reasoning Grok judge isn't truncated

# --- storage path overrides ---
# PEV_PATH=.tmp/episodic_memory.json
# CONTROLLER_STATE_PATH=.tmp/controller_state.json

# --- thinking-token headroom for reasoning models (non-visible budget) ---
# OPENAI_REASONING_HEADROOM=4096
# GEMINI_THINKING_HEADROOM=4096

# --- tuning ---
# PEV_WANDER_PROB=0.25
